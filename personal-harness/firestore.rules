rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  // Preserve the live legacy policy without allowing it to overlap Personal.
   match /{collection}/{document=**} { allow read, write: if request.auth != null && collection != 'users' && collection != '_ptiMcpAuth' && collection != 'mcpAuditLog' && collection != '_ptiLocalServices'; }
  // Fixed service mailboxes are server-only, including for the PTI owner.
  match /_ptiLocalServices/{document=**} { allow read, write: if false; }
  match /users/{uid} {
   allow read, write: if request.auth != null;
    match /{collection}/{document=**} { allow read, write: if request.auth != null && collection != 'personalData' && collection != 'sefpoData' && collection != 'foodData' && collection != 'ventureData' && collection != 'trackerData' && collection != 'weddingData' && collection != 'onePieceData' && collection != 'codexProjects' && collection != 'atlasData'; }
  }
  // Keep legacy project policy except the reserved, private account-usage document.
  // The generic grant above must exclude codexProjects: matching allows are additive.
  match /users/{uid}/codexProjects/{projectId}/{document=**} {
   allow read: if owner(uid) || (request.auth != null && projectId != 'codex-usage');
   allow write: if request.auth != null && projectId != 'codex-usage';
  }
  match /users/{uid}/codexProjects/codex-usage {
   allow read, delete: if owner(uid);
   allow create, update: if owner(uid)
    && request.resource.data.keys().hasOnly(['schemaVersion','source','collectorVersion','lastAttemptAt','publishedAt','allowance','daily'])
    && request.resource.data.schemaVersion == 1 && request.resource.data.source == 'codex-app-server'
    && request.resource.data.collectorVersion is string && request.resource.data.collectorVersion.size() <= 40
    && request.resource.data.lastAttemptAt is string && request.resource.data.lastAttemptAt.size() <= 40
    && request.resource.data.publishedAt == request.time
    && request.resource.data.allowance is map && request.resource.data.daily is map;
  }
  // One Piece: the owner path is fixed by the paired app/companion configuration.
  // No recursive grant here: unknown records and collections stay private.
  match /users/{familyUid}/onePieceData/workspace {
   function google() { return request.auth != null && request.auth.token.get('email_verified',false) == true
    && request.auth.token.get('email','') is string && request.auth.token.email.size() <= 254
    && request.auth.token.email.lower().matches('[^/@ ]+@[^/@ ]+[.][^/@ ]+')
    && request.auth.token.get('firebase',{}).get('sign_in_provider','') == 'google.com'; }
   function admin() { return google() && request.auth.uid == familyUid; }
   function workspace() { return get(/databases/$(database)/documents/users/$(familyUid)/onePieceData/workspace).data; }
   function membership() { return get(/databases/$(database)/documents/users/$(familyUid)/onePieceData/workspace/members/$(request.auth.token.email.lower())).data; }
   function active() { return google() && workspace().ownerUid == familyUid && workspace().active == true
    && (admin() || (membership().email == request.auth.token.email.lower() && membership().uid == request.auth.uid && membership().role == 'member' && membership().active == true)); }
   function self(profileUid) { return active() && request.auth.uid == profileUid; }
   function text(d,k,n) { return d[k] is string && d[k].size() <= n; }
   function label(d,k,n) { return text(d,k,n) && d[k].matches('[^<>]*'); }
   function instant(d,k) { return d[k] is int && d[k] >= 0 && d[k] <= request.time.toMillis() + 300000; }
   function counter(d,k) { return d[k] is int && d[k] >= 1 && d[k] <= 9007199254740991; }
   function episode(id) { return id is string && id != 'one-piece-0590'
    && id.matches('one-piece-(000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|10[0-7][0-9]|108[0-5])'); }
   function validWorkspace(d) { return d.keys().hasAll(['schemaVersion','ownerUid','active','label','revision','createdAt','updatedAt'])
    && d.keys().hasOnly(['schemaVersion','ownerUid','active','label','revision','createdAt','updatedAt']) && d.schemaVersion == 1
    && d.ownerUid == familyUid && d.active is bool && label(d,'label',80) && d.label.size() > 0
    && counter(d,'revision') && instant(d,'createdAt') && instant(d,'updatedAt'); }
   allow get: if active();
   allow create: if admin() && validWorkspace(request.resource.data) && request.resource.data.revision == 1;
   allow update: if admin() && validWorkspace(request.resource.data) && request.resource.data.revision == resource.data.revision + 1
    && request.resource.data.createdAt == resource.data.createdAt;
   allow delete: if false;
   match /accessRequests/{requestUid} {
    function valid(d) { return d.keys().hasAll(['uid','email','name','status','createdAt','updatedAt','revision'])
     && d.keys().hasOnly(['uid','email','name','status','createdAt','updatedAt','revision'])
     && d.uid == requestUid && text(d,'uid',128) && d.uid.matches('[A-Za-z0-9_-]{1,128}')
     && text(d,'email',254) && d.email == d.email.lower() && d.email.matches('[^/@ ]+@[^/@ ]+[.][^/@ ]+')
     && label(d,'name',80) && d.status in ['pending','approved','declined']
     && instant(d,'createdAt') && instant(d,'updatedAt') && d.updatedAt >= d.createdAt && counter(d,'revision'); }
    function approvedMember(d) {
     let memberPath = /databases/$(database)/documents/users/$(familyUid)/onePieceData/workspace/members/$(d.email);
     let after = getAfter(memberPath).data;
     return after.uid == requestUid && after.email == d.email && after.role == 'member' && after.active == true
      && after.name == d.name && after.invitedBy == familyUid && after.updatedAt == d.updatedAt
      // Require a member write in this same atomic operation, including when
      // an active legacy invitation already exists for this identity.
      && ((!exists(memberPath) && after.revision == 1)
       || (exists(memberPath) && get(memberPath).data.active == true && get(memberPath).data.role == 'member'
        && get(memberPath).data.uid in ['',requestUid] && after.revision == get(memberPath).data.revision + 1));
    }
    allow get: if admin() || (google() && request.auth.uid == requestUid);
    allow list: if admin();
    allow create: if google() && request.auth.uid == requestUid && workspace().active == true && workspace().ownerUid == familyUid
     && valid(request.resource.data) && request.resource.data.email == request.auth.token.email.lower()
     && request.resource.data.status == 'pending' && request.resource.data.revision == 1
     && request.resource.data.createdAt == request.resource.data.updatedAt;
    allow update: if admin() && workspace().active == true && workspace().ownerUid == familyUid
     && valid(request.resource.data) && resource.data.status == 'pending'
     && request.resource.data.status in ['approved','declined'] && request.resource.data.revision == resource.data.revision + 1
     && request.resource.data.updatedAt >= resource.data.updatedAt
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','revision'])
     && (request.resource.data.status == 'declined' || approvedMember(request.resource.data));
    allow delete: if false;
   }
   match /members/{email} {
    function valid(d) { return d.keys().hasAll(['email','uid','role','active','name','invitedBy','invitedAt','updatedAt','revision'])
     && d.keys().hasOnly(['email','uid','role','active','name','invitedBy','invitedAt','updatedAt','revision'])
     && email == email.lower() && email.size() <= 254 && email.matches('[^/@ ]+@[^/@ ]+[.][^/@ ]+') && d.email == email
     && text(d,'uid',128) && (d.uid == '' || d.uid.matches('[A-Za-z0-9_-]{1,128}'))
     && d.role in ['owner','member','blocked'] && d.active is bool && label(d,'name',80)
     && d.invitedBy == familyUid && instant(d,'invitedAt') && instant(d,'updatedAt') && counter(d,'revision')
     && (d.role != 'owner' || (d.uid == familyUid && email == request.auth.token.email.lower())); }
    allow get: if admin() || (google() && request.auth.token.email.lower() == email);
    allow list: if admin();
    allow create: if admin() && valid(request.resource.data) && request.resource.data.revision == 1;
    allow update: if valid(request.resource.data) && request.resource.data.revision == resource.data.revision + 1
     && request.resource.data.invitedAt == resource.data.invitedAt && request.resource.data.invitedBy == resource.data.invitedBy
     && ((admin() && (resource.data.uid == '' || request.resource.data.uid == resource.data.uid))
      || (google() && request.auth.token.email.lower() == email && resource.data.uid == ''
       && resource.data.role == 'member' && resource.data.active == true && workspace().active == true
       && request.resource.data.uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid','revision','updatedAt'])));
    allow delete: if admin() && resource.data.role != 'owner';
   }
   match /profiles/{profileUid} {
    function valid(d) { return d.keys().hasAll(['uid','displayName','audioLanguage','subtitleLanguage','autoplay','showTitles','revision','updatedAt'])
     && d.keys().hasOnly(['uid','displayName','audioLanguage','subtitleLanguage','autoplay','showTitles','revision','updatedAt'])
     && d.uid == profileUid && label(d,'displayName',80) && d.audioLanguage in ['ja','en'] && d.subtitleLanguage in ['en','off']
     && d.autoplay is bool && d.showTitles is bool && counter(d,'revision') && instant(d,'updatedAt'); }
    allow get: if self(profileUid) || (admin() && workspace().active == true);
    allow list: if false;
    allow create: if self(profileUid) && valid(request.resource.data) && request.resource.data.revision == 1;
    allow update: if valid(request.resource.data) && request.resource.data.revision == resource.data.revision + 1
     && (self(profileUid) || (admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','revision','updatedAt'])));
    allow delete: if false;
    match /progress/{episodeId} {
     function currentLease() { return getAfter(/databases/$(database)/documents/users/$(familyUid)/onePieceData/workspace/leases/$(profileUid)).data; }
     function valid(d) { return d.keys().hasAll(['episodeId','sessionId','generation','authorityEpoch','revision','positionSeconds','durationSeconds','watched','reason','updatedAt'])
      && d.keys().hasOnly(['episodeId','sessionId','generation','authorityEpoch','revision','positionSeconds','durationSeconds','watched','reason','updatedAt'])
      && d.episodeId == episodeId && episode(episodeId) && text(d,'sessionId',128) && d.sessionId.size() >= 16
      && counter(d,'generation') && counter(d,'authorityEpoch') && counter(d,'revision')
      && d.positionSeconds is number && d.positionSeconds >= 0 && d.durationSeconds is number && d.durationSeconds > 0 && d.durationSeconds <= 21600 && d.positionSeconds <= d.durationSeconds
      && d.watched is bool && d.reason in ['heartbeat','pause','seek','restart','ended','transition','mark-watched'] && instant(d,'updatedAt')
      && currentLease().sessionId == d.sessionId && currentLease().generation == d.generation && currentLease().authorityEpoch == d.authorityEpoch
      && currentLease().revision == d.revision && currentLease().expiresAt > request.time.toMillis(); }
     allow get, list: if self(profileUid);
     allow create: if self(profileUid) && valid(request.resource.data);
     allow update: if self(profileUid) && valid(request.resource.data)
      && (request.resource.data == resource.data || request.resource.data.generation > resource.data.generation
       || (request.resource.data.generation == resource.data.generation && request.resource.data.authorityEpoch >= resource.data.authorityEpoch && request.resource.data.revision > resource.data.revision));
     allow delete: if false;
    }
   }
   match /leases/{profileUid} {
    function valid(d) { return d.keys().hasAll(['sessionId','deviceId','destination','generation','authorityEpoch','revision','expiresAt','updatedAt'])
     && d.keys().hasOnly(['sessionId','deviceId','destination','generation','authorityEpoch','revision','expiresAt','updatedAt'])
     && text(d,'sessionId',128) && d.sessionId.size() >= 16 && text(d,'deviceId',128) && d.deviceId.size() > 0
     && d.destination in ['local','cast','hdmi'] && counter(d,'generation') && counter(d,'authorityEpoch')
     && d.revision is int && d.revision >= 0 && d.revision <= 9007199254740991 && instant(d,'updatedAt')
     && d.expiresAt is int && d.expiresAt >= request.time.toMillis() - 300000 && d.expiresAt <= request.time.toMillis() + 14400000; }
    allow get: if self(profileUid);
    allow list, delete: if false;
    // This is a latest-state mirror, not an event journal. The PC may have made
    // several accepted transitions while cloud writes were unavailable.
    allow create: if self(profileUid) && valid(request.resource.data);
    allow update: if self(profileUid) && valid(request.resource.data)
     && ((request.resource.data.generation > resource.data.generation && request.resource.data.sessionId != resource.data.sessionId)
      || (request.resource.data.generation == resource.data.generation && request.resource.data.sessionId == resource.data.sessionId && request.resource.data.deviceId == resource.data.deviceId
       && request.resource.data.revision >= resource.data.revision
       && ((request.resource.data.destination == resource.data.destination && request.resource.data.authorityEpoch == resource.data.authorityEpoch)
        || request.resource.data.authorityEpoch > resource.data.authorityEpoch)));
   }
  }
   // Wedding: one shared family record. A public invitation never reads this namespace.
   match /users/{uid}/weddingData/workspace {
    function verified() { return request.auth != null && request.auth.token.get('email_verified',false) == true && request.auth.token.get('email','') is string && request.auth.token.email.size() > 3; }
    function memberRole() {
     return verified() && exists(/databases/$(database)/documents/users/$(uid)/weddingData/workspace/members/$(request.auth.token.email.lower()))
      ? get(/databases/$(database)/documents/users/$(uid)/weddingData/workspace/members/$(request.auth.token.email.lower())).data.get('role','pending') : 'pending';
    }
    function admin() { return owner(uid) || memberRole() == 'admin'; }
    function family() { return owner(uid) || memberRole() in ['admin','family','editor','viewer']; }
    function editor() { return owner(uid) || memberRole() in ['admin','family','editor']; }
    function ownerEmail(email) { return get(/databases/$(database)/documents/users/$(uid)/weddingData/workspace).data.get('ownerEmail','') == email; }
    function text(d,k,n) { return d[k] is string && d[k].size() <= n; }
    function day(d,k) { return text(d,k,10) && (d[k] == '' || d[k].matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')); }
    function instant(d,k) { return text(d,k,40) && (d[k] == '' || d[k].matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2}(.[0-9]{1,3})?)?(Z|[+-][0-9]{2}:[0-9]{2})')); }
    function status(d) { return d.status in ['unresolved','proposed','confirmed']; }
    function amount(d,k) { return d[k] == null || (d[k] is number && d[k] >= 0 && d[k] <= 1000000000); }
    function occasion(id) { return id == '' || existsAfter(/databases/$(database)/documents/users/$(uid)/weddingData/workspace/events/$(id)); }
    function activeOccasion(id) { return id == '' || (occasion(id) && getAfter(/databases/$(database)/documents/users/$(uid)/weddingData/workspace/events/$(id)).data.archived == false); }
    function activeLinks(kind,d) {
     return (!(kind in ['attendance','arrangements','decisions']) || activeOccasion(d.eventId))
      && (kind != 'attendance' || getAfter(/databases/$(database)/documents/users/$(uid)/weddingData/workspace/guests/$(d.guestId)).data.archived == false);
    }
    function base(d) {
     return d.revision is int && d.revision > 0 && d.archived is bool && text(d,'createdAt',40) && text(d,'updatedAt',40)
      && d.createdBy is string && d.updatedBy == request.auth.uid && text(d,'lastChangeId',80);
    }
    function logged(kind,id,d) {
     let change = getAfter(/databases/$(database)/documents/users/$(uid)/weddingData/workspace/history/$(d.lastChangeId)).data;
     return change.actor == request.auth.uid && change.collection == kind && change.recordId == id && change.revision == d.revision && change.after == d;
    }
    function valid(kind,d) {
     return (kind == 'events'
      && d.keys().hasOnly(['title','kind','date','startAt','arrivalAt','venue','address','mapUrl','owner','status','audience','menuText','notes','source','revision','createdAt','createdBy','updatedAt','updatedBy','archived','lastChangeId'])
      && text(d,'title',180) && d.title.size() > 0 && d.kind in ['function','meal','food-counter'] && day(d,'date') && instant(d,'startAt') && instant(d,'arrivalAt')
      && text(d,'venue',500) && text(d,'address',1200) && text(d,'mapUrl',2000) && (d.mapUrl == '' || d.mapUrl.matches('https://(maps[.]google[.]com|www[.]google[.]com|google[.]com|maps[.]app[.]goo[.]gl|goo[.]gl)(/.*)?'))
      && text(d,'owner',180) && status(d) && text(d,'audience',500) && text(d,'menuText',16000) && text(d,'notes',6000) && text(d,'source',2000))
     || (kind == 'guests'
      && d.keys().hasOnly(['name','household','family','phone','dietary','arrivalAt','departureAt','stayFrom','stayUntil','accommodation','room','transport','notes','revision','createdAt','createdBy','updatedAt','updatedBy','archived','lastChangeId'])
      && text(d,'name',180) && d.name.size() > 0 && text(d,'household',180) && text(d,'family',120) && text(d,'phone',80) && text(d,'dietary',1200)
      && instant(d,'arrivalAt') && instant(d,'departureAt') && day(d,'stayFrom') && day(d,'stayUntil') && (d.stayFrom == '' || d.stayUntil == '' || d.stayUntil > d.stayFrom)
      && text(d,'accommodation',500) && text(d,'room',180) && text(d,'transport',1200) && text(d,'notes',6000))
     || (kind == 'attendance'
      && d.keys().hasOnly(['guestId','eventId','status','revision','createdAt','createdBy','updatedAt','updatedBy','archived','lastChangeId'])
      && text(d,'guestId',120) && text(d,'eventId',120) && d.guestId.size() > 0 && d.eventId.size() > 0 && d.status in ['unknown','tentative','confirmed','declined']
      && existsAfter(/databases/$(database)/documents/users/$(uid)/weddingData/workspace/guests/$(d.guestId))
      && occasion(d.eventId))
     || (kind == 'arrangements'
      && d.keys().hasOnly(['title','category','eventId','owner','status','due','vendor','contact','agreedAmount','paidAmount','notes','revision','createdAt','createdBy','updatedAt','updatedBy','archived','lastChangeId'])
      && text(d,'title',180) && d.title.size() > 0 && text(d,'category',120) && text(d,'eventId',120) && occasion(d.eventId) && text(d,'owner',180) && status(d) && day(d,'due')
      && text(d,'vendor',300) && text(d,'contact',500) && amount(d,'agreedAmount') && amount(d,'paidAmount') && text(d,'notes',6000))
     || (kind == 'decisions'
      && d.keys().hasOnly(['title','eventId','owner','status','due','proposal','resolution','source','revision','createdAt','createdBy','updatedAt','updatedBy','archived','lastChangeId'])
      && text(d,'title',180) && d.title.size() > 0 && text(d,'eventId',120) && occasion(d.eventId) && text(d,'owner',180) && status(d) && day(d,'due')
      && text(d,'proposal',6000) && text(d,'resolution',6000) && (d.status != 'confirmed' || d.resolution.size() > 0) && text(d,'source',2000));
    }
    allow read: if family();
    allow create, update, delete: if false; // Provisioned once by the reviewed release script.
    match /accessRequests/{accountUid} {
     function profile(d) { return d.keys().hasAll(['uid','email','name','firstSeenAt','lastSeenAt']) && d.keys().hasOnly(['uid','email','name','firstSeenAt','lastSeenAt'])
      && d.uid == accountUid && d.email == request.auth.token.email.lower() && text(d,'email',254) && text(d,'name',180) && instant(d,'firstSeenAt') && instant(d,'lastSeenAt'); }
     allow get: if admin() || (verified() && request.auth.uid == accountUid);
     allow list: if admin();
     allow create: if verified() && request.auth.uid == accountUid && profile(request.resource.data)
      && request.resource.data.firstSeenAt != '' && request.resource.data.firstSeenAt == request.resource.data.lastSeenAt;
     allow update: if verified() && request.auth.uid == accountUid && profile(request.resource.data)
      && request.resource.data.email == resource.data.email && request.resource.data.uid == resource.data.uid
      && (request.resource.data.firstSeenAt == resource.data.firstSeenAt || resource.data.firstSeenAt == '')
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','lastSeenAt','firstSeenAt']);
     allow delete: if false;
    }
    match /members/{email} {
     function validMember(d) { return d.keys().hasAll(['email','name','role','invitedAt','invitedBy']) && d.keys().hasOnly(['email','name','role','invitedAt','invitedBy','updatedAt','updatedBy'])
      && d.email == email && email == email.lower() && email.size() <= 254 && email.matches('[^/@ ]+@[^/@ ]+[.][^/@ ]+')
      && text(d,'name',180) && d.role in ['admin','family','viewer','blocked','editor'] && text(d,'invitedAt',40) && text(d,'invitedBy',128)
      && (!('updatedAt' in d) || instant(d,'updatedAt')) && (!('updatedBy' in d) || d.updatedBy == request.auth.uid)
      && (!ownerEmail(email) || d.role == 'admin'); }
     allow get: if admin() || (verified() && request.auth.token.email.lower() == email);
     allow list: if admin();
     allow create: if admin() && validMember(request.resource.data) && request.resource.data.invitedBy == request.auth.uid;
     allow update: if admin() && validMember(request.resource.data) && request.resource.data.invitedBy == resource.data.invitedBy && request.resource.data.invitedAt == resource.data.invitedAt;
     allow delete: if admin() && !ownerEmail(email);
    }
    match /{kind}/{id} {
     allow read: if family() && kind in ['events','guests','attendance','arrangements','decisions','history'];
     allow create: if editor() && kind in ['events','guests','attendance','arrangements','decisions']
      && base(request.resource.data) && valid(kind,request.resource.data) && request.resource.data.revision == 1 && request.resource.data.createdBy == request.auth.uid
      && request.resource.data.archived == false && logged(kind,id,request.resource.data) && activeLinks(kind,request.resource.data)
      && (kind != 'attendance' || id == request.resource.data.guestId + '--' + request.resource.data.eventId);
     allow update: if editor() && kind in ['events','guests','attendance','arrangements','decisions']
      && base(request.resource.data) && valid(kind,request.resource.data) && request.resource.data.revision == resource.data.revision + 1
      && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.createdBy == resource.data.createdBy
      && logged(kind,id,request.resource.data) && (kind != 'attendance' || (request.resource.data.guestId == resource.data.guestId && request.resource.data.eventId == resource.data.eventId))
      && (!(kind in ['arrangements','decisions']) || request.resource.data.eventId == resource.data.eventId || activeOccasion(request.resource.data.eventId));
     allow delete: if false;
    }
    match /history/{changeId} {
     allow create: if editor() && request.resource.data.keys().hasOnly(['collection','recordId','revision','actor','at','before','after','action'])
      && request.resource.data.collection in ['events','guests','attendance','arrangements','decisions'] && request.resource.data.actor == request.auth.uid
      && request.resource.data.at == request.resource.data.after.updatedAt && request.resource.data.after.lastChangeId == changeId
      && request.resource.data.revision == request.resource.data.after.revision && request.resource.data.action in ['created','updated','archived']
      && request.resource.data.after == getAfter(/databases/$(database)/documents/users/$(uid)/weddingData/workspace/$(request.resource.data.collection)/$(request.resource.data.recordId)).data
      && ((!exists(/databases/$(database)/documents/users/$(uid)/weddingData/workspace/$(request.resource.data.collection)/$(request.resource.data.recordId)) && request.resource.data.before == null && request.resource.data.action == 'created')
       || (exists(/databases/$(database)/documents/users/$(uid)/weddingData/workspace/$(request.resource.data.collection)/$(request.resource.data.recordId)) && request.resource.data.before == get(/databases/$(database)/documents/users/$(uid)/weddingData/workspace/$(request.resource.data.collection)/$(request.resource.data.recordId)).data));
     allow update, delete: if false;
    }
   }
  // SEFPO is private to its signed-in owner. Agent writes use Admin SDK through PTI MCP.
  match /users/{uid}/sefpoData/workspace {
   allow read, write: if owner(uid);
   match /{collection}/{document=**} { allow read, write: if owner(uid); }
  }
  // Venture Studio: only the owner and explicitly invited verified Google accounts.
  match /users/{uid}/ventureData/workspace {
   function participant() {
    return owner(uid) || (request.auth != null && request.auth.token.get('email_verified', false) == true
      && request.auth.token.get('email', '') is string
      && exists(/databases/$(database)/documents/users/$(uid)/ventureData/workspace/members/$(request.auth.token.email.lower())));
   }
